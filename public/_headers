# Hashed build output: the file name changes whenever the content changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind index parts are named by content hash. The entry files
# (pagefind.js, pagefind-entry.json, the wasm files) keep the default
# revalidating policy because their names do not change.
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*.pf_meta
  Cache-Control: public, max-age=31536000, immutable
